    <!-- ===== MOVING SUBJECTS (physics-based, ROS 2 controlled) ===== -->
    <!--
      Replaced <actor> elements (kinematic ghosts) with proper physics models.
      Each person model has:
        - collision geometry  → physics engine stops them at walls/furniture
        - VelocityControl     → gz-sim plugin that accepts cmd_vel Twist msgs
        - OdometryPublisher   → publishes pose feedback for the ROS 2 controller
      The pedestrian_controller ROS 2 node drives them along patrol routes
      using a potential-field algorithm (goal attraction + wall/obstacle repulsion).
    -->

    <model name="person_1">
      <pose>-5.5 -2.0 0.85 0 0 0</pose>
      <link name="body">
        <!-- Gravity disabled: VelocityControl only commands linear.x / angular.z,
             so without this the model falls under gravity unchecked. -->
        <gravity>false</gravity>
        <inertial>
          <mass>70</mass>
          <inertia>
            <!-- ixx / iyy very high → resists tipping from wall-collision impulses -->
            <ixx>10000</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>10000</iyy><iyz>0</iyz><izz>5</izz>
          </inertia>
        </inertial>
        <collision name="c">
          <geometry><cylinder><radius>0.28</radius><length>1.7</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
            <contact><ode><min_depth>0.001</min_depth></ode></contact>
          </surface>
        </collision>
        <visual name="torso">
          <geometry><cylinder><radius>0.28</radius><length>1.3</length></cylinder></geometry>
          <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.2 0.4 0.8 1</diffuse></material>
        </visual>
        <visual name="head">
          <pose>0 0 0.78 0 0 0</pose>
          <geometry><sphere><radius>0.18</radius></sphere></geometry>
          <material><ambient>0.9 0.75 0.6 1</ambient><diffuse>0.9 0.75 0.6 1</diffuse></material>
        </visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system"
              name="gz::sim::systems::VelocityControl"/>
      <plugin filename="gz-sim-odometry-publisher-system"
              name="gz::sim::systems::OdometryPublisher">
        <odom_publish_frequency>10</odom_publish_frequency>
      </plugin>
    </model>

    <model name="person_2">
      <pose>3.0 6.0 0.85 0 0 -1.5708</pose>
      <link name="body">
        <gravity>false</gravity>
        <inertial>
          <mass>70</mass>
          <inertia>
            <ixx>10000</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>10000</iyy><iyz>0</iyz><izz>5</izz>
          </inertia>
        </inertial>
        <collision name="c">
          <geometry><cylinder><radius>0.28</radius><length>1.7</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
            <contact><ode><min_depth>0.001</min_depth></ode></contact>
          </surface>
        </collision>
        <visual name="torso">
          <geometry><cylinder><radius>0.28</radius><length>1.3</length></cylinder></geometry>
          <material><ambient>0.8 0.3 0.2 1</ambient><diffuse>0.8 0.3 0.2 1</diffuse></material>
        </visual>
        <visual name="head">
          <pose>0 0 0.78 0 0 0</pose>
          <geometry><sphere><radius>0.18</radius></sphere></geometry>
          <material><ambient>0.9 0.75 0.6 1</ambient><diffuse>0.9 0.75 0.6 1</diffuse></material>
        </visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system"
              name="gz::sim::systems::VelocityControl"/>
      <plugin filename="gz-sim-odometry-publisher-system"
              name="gz::sim::systems::OdometryPublisher">
        <odom_publish_frequency>10</odom_publish_frequency>
      </plugin>
    </model>

  </world>
</sdf>