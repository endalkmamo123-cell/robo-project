<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="office_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system"        name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"  name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"        name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- Bird's eye camera start position -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 0 25 0 1.5707963 0</pose>
        <projection_type>orthographic</projection_type>
      </camera>
    </gui>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Floor -->
    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 15</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 15</size></plane></geometry>
          <material>
            <ambient>0.85 0.82 0.78 1</ambient>
            <diffuse>0.85 0.82 0.78 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== OFFICE WALLS (20x15m room) ===== -->
    <model name="wall_north">
      <static>true</static>
      <link name="link">
        <pose>0 7.5 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>20 0.15 3</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>20 0.15 3</size></box></geometry>
          <material><ambient>0.92 0.90 0.88 1</ambient><diffuse>0.92 0.90 0.88 1</diffuse></material>
        </visual>
